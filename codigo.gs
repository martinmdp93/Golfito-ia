        impacto: parseInt(data[i][7]) || 0,
        follow_through: parseInt(data[i][8]) || 0,
        transferencia_peso: parseInt(data[i][9]) || 0
      };
    }
    return null;
  } catch(err) { Logger.log("Error _obtenerUltimoIndiceGolfito: " + err); return null; }
}

